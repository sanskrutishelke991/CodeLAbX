{% extends "base.html" %}
{% load static %}

{% block title %}CodeLabX — Learn to code with an AI that actually helps{% endblock %}

{% block extra_css %}

<style>
/* ==============================================
   SUBTLE SOFT AURORA - Professional Version
   ============================================== */

body.landing-page {
    background: #0A0A0A !important;
    overflow-x: hidden;
    position: relative;
}

/* Subtle aurora - only visible at top */
.aurora-subtle {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
}

.aurora-subtle::before {
    content: '';
    position: absolute;
    top: -30%;
    left: 30%;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(20, 184, 166, 0.15) 0%, transparent 60%);
    border-radius: 50%;
    filter: blur(60px);
    animation: subtleFloat1 20s ease-in-out infinite;
}

.aurora-subtle::after {
    content: '';
    position: absolute;
    top: -20%;
    right: 20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.12) 0%, transparent 60%);
    border-radius: 50%;
    filter: blur(60px);
    animation: subtleFloat2 25s ease-in-out infinite;
}

@keyframes subtleFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.6; }
    50% { transform: translate(50px, 30px) scale(1.1); opacity: 0.8; }
}

@keyframes subtleFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.5; }
    50% { transform: translate(-40px, 40px) scale(1.05); opacity: 0.7; }
}

/* All content above aurora */
body.landing-page > *:not(.aurora-subtle) {
    position: relative;
    z-index: 1;
}

/* Light mode */
[data-theme="light"] body.landing-page {
    background: #F9F9FB !important;
}

[data-theme="light"] .aurora-subtle::before {
    background: radial-gradient(circle, rgba(20, 184, 166, 0.08) 0%, transparent 60%);
}

[data-theme="light"] .aurora-subtle::after {
    background: radial-gradient(circle, rgba(6, 182, 212, 0.06) 0%, transparent 60%);
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
    .aurora-subtle::before,
    .aurora-subtle::after {
        animation: none;
    }
}

@media (max-width: 768px) {
    .aurora-subtle::before,
    .aurora-subtle::after {
        width: 400px;
        height: 400px;
    }
}
</style>


<style>
/* Hide duplicate landing header - keep only base.html header */
.landing-page > header,
.landing-page > nav.landing-nav,
.landing-page .site-nav,
.landing-page .landing-header,
.landing-nav {
    display: none !important;
}
</style>

<style>
    html {
        scroll-behavior: smooth;
    }

    .landing-page {
        background: var(--bg-primary);
        color: var(--text-secondary);
    }
    
    /* Reset main container for landing */
    body {
        padding-bottom: 0 !important;
    }
    
    .main-container {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    
    .landing-page .main-content {
        margin-left: 0;
        padding: 0;
        width: 100%;
    }
    
    /* Center all landing sections */
    .landing-page section,
    .landing-page .container,
    .landing-page .section-container {
        max-width: 1200px;
        margin-left: auto !important;
        margin-right: auto !important;
        padding-left: 24px;
        padding-right: 24px;
    }
    
    /* Hero centered */
    .landing-page .hero,
    .landing-page .hero-section {
        text-align: center;
        min-height: 90vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .landing-shell {
        min-height: 100vh;
        background:
            radial-gradient(circle at top left, rgba(0, 85, 255, 0.10), transparent 28%),
            var(--bg-primary);
        position: relative;
        overflow: hidden;
    }

    .landing-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
        background-size: 72px 72px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,0.65), transparent 100%);
        pointer-events: none;
    }

    .landing-topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-6) clamp(1.25rem, 3vw, 2rem);
        background: rgba(10, 10, 10, 0.7);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-subtle);
    }

    .brand-mark {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        letter-spacing: var(--tracking-wide);
        text-transform: uppercase;
    }

    .brand-mark svg {
        width: 18px;
        height: 18px;
        color: var(--accent);
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .nav-link {
        font-family: 'Inter', sans-serif;
        font-size: var(--text-sm);
        color: var(--text-secondary);
        padding: 0.65rem 0.9rem;
        border-radius: var(--radius-md);
        transition: all var(--transition-fast);
        cursor: pointer;
    }

    .nav-link:hover {
        color: var(--text-primary);
        background: var(--bg-tertiary);
    }

    .section-shell {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
        padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 3vw, 2rem);
    }

    .hero-shell {
        padding-top: clamp(4rem, 9vw, 7rem);
        padding-bottom: clamp(3rem, 6vw, 4.5rem);
        text-align: center;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-full);
        color: var(--text-tertiary);
        font-family: 'Inter', sans-serif;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-bottom: var(--space-6);
    }

    .hero-title {
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 0.95;
        letter-spacing: -0.03em;
        max-width: 900px;
        margin: 0 auto var(--space-5);
    }

    .hero-subtitle {
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        max-width: 700px;
        margin: 0 auto var(--space-8);
        color: var(--text-secondary);
    }

    .hero-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--space-3);
        margin-bottom: var(--space-8);
    }

    .btn-landing-primary,
    .btn-landing-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        font-family: 'Inter', sans-serif;
        font-size: 0.96rem;
        font-weight: 600;
        border-radius: var(--radius-md);
        padding: 0.9rem 1.2rem;
        transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
        cursor: pointer;
    }

    .btn-landing-primary {
        background: var(--accent);
        color: white;
        border: 1px solid var(--accent);
    }

    .btn-landing-primary:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
    }

    .btn-landing-secondary {
        background: transparent;
        color: var(--text-primary);
        border: 1px solid var(--border-default);
    }

    .btn-landing-secondary:hover {
        background: var(--bg-tertiary);
        border-color: var(--border-subtle);
        transform: translateY(-1px);
    }

    .trust-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--space-4);
        color: var(--text-tertiary);
        font-size: 0.95rem;
    }

    .trust-row span {
        position: relative;
        padding-left: 0.95rem;
    }

    .trust-row span::before {
        content: "•";
        position: absolute;
        left: 0;
        color: var(--accent);
    }

    .proof-strip {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: var(--space-4);
        padding: 1rem 1.25rem 0;
        color: var(--text-tertiary);
        font-family: 'Inter', sans-serif;
        font-size: 0.92rem;
        border-top: 1px solid var(--border-subtle);
        margin: 0 auto;
        max-width: 1100px;
    }

    .proof-logos {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .logo-pill {
        border: 1px solid var(--border-default);
        border-radius: var(--radius-full);
        padding: 0.55rem 0.8rem;
        color: var(--text-secondary);
        background: var(--bg-secondary);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .logo-pill svg {
        width: 16px;
        height: 16px;
        color: var(--text-primary);
    }

    .section-heading {
        max-width: 760px;
        margin-bottom: var(--space-8);
    }

    .section-heading h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: var(--space-3);
    }

    .section-heading p {
        font-size: 1.05rem;
        color: var(--text-secondary);
    }

    .problem-grid,
    .feature-grid,
    .steps-grid,
    .tech-grid,
    .stat-grid {
        display: grid;
        gap: var(--space-4);
    }

    .problem-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .feature-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .steps-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .tech-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .problem-card,
    .feature-card,
    .step-card,
    .tech-card,
    .stat-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        transition: transform var(--transition-base), border-color var(--transition-base), background var(--transition-base);
    }

    .problem-card:hover,
    .feature-card:hover,
    .step-card:hover,
    .tech-card:hover {
        transform: translateY(-2px);
        border-color: var(--border-subtle);
    }

    .problem-card h3,
    .feature-card h3,
    .step-card h3,
    .tech-card h3 {
        font-family: 'Inter', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: var(--space-2);
    }

    .problem-card p,
    .feature-card p,
    .step-card p,
    .tech-card p,
    .stat-card p {
        margin-bottom: 0;
        color: var(--text-secondary);
    }

    .problem-card .icon,
    .feature-card .icon {
        display: inline-flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        margin-bottom: var(--space-4);
        color: var(--accent);
        background: rgba(0, 85, 255, 0.06);
    }

    .feature-card .link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        margin-top: var(--space-4);
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        color: var(--text-primary);
        cursor: pointer;
    }

    .step-card {
        position: relative;
        overflow: hidden;
        min-height: 220px;
    }

    .step-number {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: 2rem;
        color: var(--accent);
        margin-bottom: var(--space-3);
    }

    .step-card::after {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 60px;
        height: 60px;
        border-left: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
        transform: translate(30%, -30%) rotate(45deg);
        opacity: 0.5;
    }

    .showcase-card {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: var(--space-8);
        align-items: center;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-xl);
        padding: clamp(1.25rem, 3vw, 2rem);
        background: linear-gradient(140deg, rgba(255,255,255,0.02), transparent 70%), var(--bg-secondary);
    }

    .showcase-copy h2 {
        font-size: clamp(1.8rem, 3.2vw, 2.6rem);
        margin-bottom: var(--space-4);
    }

    .showcase-copy p {
        font-size: 1.04rem;
        color: var(--text-secondary);
    }

    .showcase-preview {
        border: 1px solid var(--border-default);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--bg-primary);
    }

    .preview-topbar {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.8rem 1rem;
        border-bottom: 1px solid var(--border-default);
        background: rgba(255,255,255,0.02);
    }

    .preview-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--border-default);
    }

    .preview-body {
        display: grid;
        grid-template-columns: 120px 1fr;
        min-height: 320px;
    }

    .preview-sidebar {
        border-right: 1px solid var(--border-default);
        padding: var(--space-4);
        background: rgba(255,255,255,0.02);
    }

    .preview-sidebar span {
        display: block;
        height: 10px;
        background: var(--border-subtle);
        border-radius: var(--radius-full);
        margin-bottom: var(--space-3);
    }

    .preview-main {
        padding: var(--space-5);
        display: grid;
        gap: var(--space-4);
    }

    .preview-card {
        border: 1px solid var(--border-default);
        border-radius: var(--radius-md);
        padding: var(--space-4);
        background: var(--bg-secondary);
    }

    .preview-card strong {
        display: block;
        color: var(--text-primary);
        margin-bottom: var(--space-2);
    }

    .preview-chart {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        align-items: end;
        height: 110px;
    }

    .preview-chart > span {
        background: linear-gradient(180deg, rgba(0, 85, 255, 0.95), rgba(0, 85, 255, 0.25));
        border-radius: 4px 4px 0 0;
    }

    .stat-card {
        text-align: left;
    }

    .stat-number {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: 2.2rem;
        color: var(--text-primary);
        margin-bottom: 0.35rem;
    }

    .final-cta {
        text-align: center;
        padding-bottom: clamp(4rem, 6vw, 5rem);
    }

    .final-cta h2 {
        font-size: clamp(2.2rem, 4vw, 3rem);
        margin-bottom: var(--space-3);
    }

    .final-cta p {
        max-width: 560px;
        margin: 0 auto var(--space-6);
        color: var(--text-secondary);
    }

    .footer-shell {
        border-top: 1px solid var(--border-subtle);
        padding: 1.4rem 1.25rem 2rem;
        display: flex;
        justify-content: space-between;
        gap: var(--space-4);
        flex-wrap: wrap;
        max-width: 1200px;
        margin: 0 auto;
        color: var(--text-tertiary);
        font-size: 0.95rem;
    }

    .footer-links {
        display: flex;
        gap: var(--space-4);
    }

    .footer-links a {
        color: var(--text-tertiary);
    }

    .footer-links a:hover {
        color: var(--text-primary);
    }

    .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 700ms ease, transform 700ms ease;
    }

    .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 1024px) {
        .problem-grid,
        .feature-grid,
        .steps-grid,
        .tech-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .showcase-card {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .landing-topbar {
            padding: 1rem 1rem 0.9rem;
        }

        .hero-title {
            font-size: clamp(2.5rem, 10vw, 3.4rem);
        }

        .problem-grid,
        .feature-grid,
        .steps-grid,
        .tech-grid,
        .stat-grid {
            grid-template-columns: 1fr;
        }

        .preview-body {
            grid-template-columns: 1fr;
        }

        .preview-sidebar {
            border-right: 0;
            border-bottom: 1px solid var(--border-default);
        }

        .footer-shell {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
{% endblock %}

<style>
/* Hide base header on landing */
.top-header {
    display: none !important;
}
body {
    padding-bottom: 0 !important;
}
</style>

{% block content %}

<div class="aurora-subtle"></div>


        </section>

        <section class="section-shell">
            <div class="section-heading reveal">
                <div class="eyebrow">Technology</div>
                <h2>Simple stack. Serious foundation.</h2>
                <p>The platform is built with durable tools that support clarity, speed, and future growth.</p>
            </div>
            <div class="tech-grid">
                <article class="tech-card reveal">
                    <h3>Django</h3>
                    <p>Reliable backend structure for features and growth.</p>
                </article>
                <article class="tech-card reveal">
                    <h3>Python</h3>
                    <p>Language-first experience for practical learning.</p>
                </article>
                <article class="tech-card reveal">
                    <h3>Gemini AI</h3>
                    <p>Contextual guidance for roadmaps and feedback loops.</p>
                </article>
                <article class="tech-card reveal">
                    <h3>PostgreSQL</h3>
                    <p>Structured data for progress, analytics, and resilience.</p>
                </article>
            </div>
        </section>

        <section class="section-shell final-cta">
            <div class="reveal">
                <h2>Ready to start?</h2>
                <p>Open the door to a calmer, more useful way to learn. No credit card. Just learning.</p>
                <a href="{% url 'accounts:register' %}" class="btn-landing-primary">Create free account</a>
            </div>
        </section>

        <footer class="footer-shell">
            <div class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 7 12 3 18 7"></polyline>
                    <path d="M5 13h14"></path>
                    <path d="M7 10v10"></path>
                    <path d="M17 10v10"></path>
                </svg>
                CodeLabX
            </div>
            <div class="footer-links">
                <a href="#features">Product</a>
                <a href="#">Resources</a>
                <a href="#">About</a>
            </div>
            <div>© 2026 CodeLabX · made with care</div>
        </footer>
    </div>
</div>

<script>
    const revealItems = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                if (entry.target.querySelector('.stat-number')) {
                    animateCount(entry.target.querySelector('.stat-number'));
                }
            }
        });
    }, { threshold: 0.2 });

    revealItems.forEach((item) => observer.observe(item));

    function animateCount(element) {
        if (!element || element.dataset.animated) {
            return;
        }

        element.dataset.animated = 'true';
        const target = parseInt(element.dataset.count, 10);
        const duration = 1200;
        const startTime = performance.now();

        function frame(currentTime) {
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const value = Math.floor(progress * target);
            element.textContent = `${value}${target === 80 ? '%' : ''}`;
            if (progress < 1) {
                requestAnimationFrame(frame);
            } else {
                element.textContent = `${target}${target === 80 ? '%' : ''}`;
            }
        }

        requestAnimationFrame(frame);
    }
</script>
{% endblock %}
