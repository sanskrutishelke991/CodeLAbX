{% extends 'base.html' %}
{% load static %}

{% block title %}Dashboard - CodeLabX{% endblock %}

{% block extra_css %}
<style>
    .dashboard-shell {
        display: grid;
        gap: 1.2rem;
    }

    .dashboard-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.2rem;
        padding: 1.4rem 1.4rem 1.2rem;
        border: 1px solid var(--border-default);
        border-radius: var(--radius-xl);
        background: var(--bg-secondary);
    }

    .hero-copy h1 {
        font-size: clamp(2rem, 3.4vw, 2.8rem);
        margin-bottom: 0.4rem;
    }

    .hero-copy p {
        margin-bottom: 0;
        color: var(--text-secondary);
    }

    .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.7rem;
        border-radius: var(--radius-full);
        border: 1px solid var(--border-default);
        background: var(--bg-tertiary);
        color: var(--text-tertiary);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        margin-bottom: 0.8rem;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.9rem;
        padding: 0.2rem 0;
    }

    .stat-item {
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
        padding: 0.8rem 0;
        border-right: 1px solid var(--border-subtle);
    }

    .stat-item:last-child {
        border-right: 0;
    }

    .stat-item .value {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.35rem;
        color: var(--text-primary);
    }

    .stat-item .label {
        font-size: 0.88rem;
        color: var(--text-tertiary);
    }

    .panel-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 1rem;
    }

    .panel {
        background: var(--bg-secondary);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-xl);
        padding: 1.15rem;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        margin-bottom: 1rem;
    }

    .panel-head h2 {
        font-size: 1.2rem;
        margin: 0;
    }

    .panel-link {
        color: var(--text-tertiary);
        font-size: 0.9rem;
        text-decoration: none;
    }

    .panel-link:hover {
        color: var(--text-primary);
    }

    .today-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    .today-card {
        border: 1px solid var(--border-default);
        border-radius: var(--radius-xl);
        padding: 1.1rem;
        background: var(--bg-secondary);
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 220px;
    }

    .today-card h3 {
        font-size: 1.3rem;
        margin: 0;
    }

    .today-card p {
        margin: 0;
        color: var(--text-secondary);
    }

    .card-kicker {
        font-size: 0.78rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        font-weight: 600;
    }

    .today-card .btn-inline {
        margin-top: auto;
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
    }

    .roadmap-list {
        display: grid;
        gap: 0.7rem;
    }

    .roadmap-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 0.75rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-subtle);
        background: var(--bg-tertiary);
    }

    .roadmap-meta {
        display: grid;
        gap: 0.25rem;
    }

    .roadmap-meta strong {
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .roadmap-meta span {
        color: var(--text-tertiary);
        font-size: 0.84rem;
    }

    .progress-line {
        width: 120px;
        height: 6px;
        border-radius: var(--radius-full);
        background: var(--bg-primary);
        overflow: hidden;
        margin-top: 0.35rem;
    }

    .progress-line > span {
        display: block;
        height: 100%;
        background: var(--accent);
    }

    .empty-state {
        border: 1px dashed var(--border-default);
        border-radius: var(--radius-lg);
        padding: 1rem;
        text-align: center;
        color: var(--text-secondary);
    }

    .empty-state h3 {
        font-size: 1.05rem;
        color: var(--text-primary);
        margin-bottom: 0.35rem;
    }

    .skeleton-stack {
        display: grid;
        gap: 0.6rem;
    }

    .skeleton-line,
    .skeleton-block {
        border-radius: var(--radius-md);
        background: var(--bg-tertiary);
        animation: pulse 1.2s ease-in-out infinite;
    }

    .skeleton-line {
        height: 10px;
    }

    .skeleton-line.short { width: 55%; }
    .skeleton-block { height: 88px; }

    @keyframes pulse {
        0%, 100% { opacity: 0.75; }
        50% { opacity: 1; }
    }

    .heatmap-shell {
        display: grid;
        gap: 0.8rem;
    }

    .heatmap-grid {
        display: grid;
        grid-template-columns: repeat(52, 1fr);
        gap: 3px;
    }

    .heatmap-cell {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        background: var(--bg-tertiary);
        border: 1px solid var(--border-subtle);
        transition: transform var(--transition-fast), border-color var(--transition-fast);
    }

    .heatmap-cell:hover {
        transform: scale(1.25);
        border-color: var(--text-tertiary);
    }

    .heatmap-cell.level-0 { background: var(--bg-tertiary); }
    .heatmap-cell.level-1 { background: rgba(0, 85, 255, 0.18); }
    .heatmap-cell.level-2 { background: rgba(0, 85, 255, 0.32); }
    .heatmap-cell.level-3 { background: rgba(0, 85, 255, 0.54); }
    .heatmap-cell.level-4 { background: var(--accent); }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--text-tertiary);
        font-size: 0.8rem;
    }

    .legend-cell {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        border: 1px solid var(--border-subtle);
    }

    .badge-list {
        display: grid;
        gap: 0.7rem;
    }

    .badge-item {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.7rem 0.6rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        background: var(--bg-tertiary);
    }

    .badge-item .icon {
        width: 34px;
        height: 34px;
        border-radius: var(--radius-md);
        display: grid;
        place-items: center;
        background: rgba(0, 85, 255, 0.12);
        color: var(--accent);
    }

    .tool-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
    }

    .tool-card {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.8rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        background: var(--bg-tertiary);
        color: var(--text-primary);
        text-decoration: none;
    }

    .tool-card:hover {
        border-color: var(--border-default);
    }

    @media (max-width: 1024px) {
        .panel-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .dashboard-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .stats-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.8rem;
        }

        .stat-item {
            border-right: 0;
            border-bottom: 1px solid var(--border-subtle);
            padding-bottom: 0.8rem;
        }

        .stat-item:nth-child(odd) {
            border-bottom: 1px solid var(--border-subtle);
        }

        .today-grid,
        .tool-grid {
            grid-template-columns: 1fr;
        }

        .heatmap-grid {
            grid-template-columns: repeat(26, 1fr);
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="dashboard-shell">
    <section class="dashboard-hero">
        <div class="hero-copy">
            <div class="hero-pill">{% now "M j" %} · streak {{ current_streak|default:0 }}</div>
            <h1>Good morning, {{ user.get_full_name|default:user.username }}</h1>
            <p>Continue where you left off and keep the momentum steady.</p>
        </div>
        <a href="{% url 'learning:roadmaps' %}" class="btn btn-primary btn-sm">Resume learning</a>
    </section>

    <section class="stats-row" aria-label="Progress snapshot">
        <div class="stat-item">
            <div class="value" data-count="{{ active_roadmaps|default:0 }}">0</div>
            <div class="label">active paths</div>
        </div>
        <div class="stat-item">
            <div class="value" data-count="{{ days_completed|default:0 }}">0</div>
            <div class="label">days completed</div>
        </div>
        <div class="stat-item">
            <div class="value" data-count="{{ total_hours|default:0 }}">0</div>
            <div class="label">hours studied</div>
        </div>
        <div class="stat-item">
            <div class="value" data-count="{{ recent_badges|length|default:0 }}">0</div>
            <div class="label">recent badges</div>
        </div>
    </section>

    <section class="today-grid">
        <article class="today-card">
            <div class="card-kicker">Today</div>
            {% if roadmaps %}
                <h3>{{ roadmaps.0.title }}</h3>
                <p>Pick up the next step in your current roadmap and keep your streak alive.</p>
                <a href="{% url 'learning:roadmap_detail' roadmaps.0.id %}" class="btn-inline">Continue →</a>
            {% else %}
                <div class="skeleton-stack">
                    <div class="skeleton-line short"></div>
                    <div class="skeleton-line"></div>
                    <div class="skeleton-line"></div>
                    <div class="skeleton-block"></div>
                </div>
            {% endif %}
        </article>
        <article class="today-card">
            <div class="card-kicker">Daily challenge</div>
            <h3>Practice with intent</h3>
            <p>One focused exercise is enough to make the day count.</p>
            <a href="{% url 'practice:home' %}" class="btn-inline">Open practice →</a>
        </article>
    </section>

    <section class="panel-grid">
        <div class="panel">
            <div class="panel-head">
                <h2>Your paths</h2>
                <a href="{% url 'learning:roadmaps' %}" class="panel-link">View all</a>
            </div>
            {% if roadmaps %}
                <div class="roadmap-list">
                    {% for roadmap in roadmaps %}
                    <div class="roadmap-item">
                        <div class="roadmap-meta">
                            <strong>{{ roadmap.title }}</strong>
                            <span>{{ roadmap.completed_days }}/{{ roadmap.total_days }} days · {{ roadmap.get_level_display }}</span>
                            <div class="progress-line"><span style="width: {{ roadmap.progress_percentage }}%"></span></div>
                        </div>
                        <a href="{% url 'learning:roadmap_detail' roadmap.id %}" class="btn btn-secondary btn-sm">Open</a>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <h3>No roadmaps yet</h3>
                    <p>Create your first focused path and let the system guide the next steps.</p>
                    <a href="{% url 'learning:roadmap_create' %}" class="btn btn-primary btn-sm" style="margin-top: 0.8rem;">Create path</a>
                </div>
            {% endif %}
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Activity</h2>
                <span class="panel-link">Last 365 days</span>
            </div>
            <div class="heatmap-shell">
                <div class="heatmap-grid" id="heatmapGrid"></div>
                <div class="legend-row">
                    <span>Less</span>
                    <div class="legend-cell level-0"></div>
                    <div class="legend-cell level-1"></div>
                    <div class="legend-cell level-2"></div>
                    <div class="legend-cell level-3"></div>
                    <div class="legend-cell level-4"></div>
                    <span>More</span>
                </div>
            </div>
        </div>
    </section>

    <section class="panel-grid">
        <div class="panel">
            <div class="panel-head">
                <h2>Recent achievements</h2>
                <a href="{% url 'progress:achievements' %}" class="panel-link">View all</a>
            </div>
            {% if recent_badges %}
                <div class="badge-list">
                    {% for user_badge in recent_badges %}
                    <div class="badge-item">
                        <div class="icon">{{ user_badge.badge.icon }}</div>
                        <div>
                            <strong style="display:block; color: var(--text-primary);">{{ user_badge.badge.name }}</strong>
                            <span style="color: var(--text-tertiary); font-size: 0.84rem;">Earned {{ user_badge.earned_at|timesince }} ago</span>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <h3>No badges yet</h3>
                    <p>Complete lessons and challenges to start building your record.</p>
                </div>
            {% endif %}
        </div>

        <div class="panel">
            <div class="panel-head">
                <h2>Quick access</h2>
            </div>
            <div class="tool-grid">
                <a href="{% url 'learning:roadmaps' %}" class="tool-card">
                    <span class="icon"><i data-lucide="map"></i></span>
                    <span>Roadmaps</span>
                </a>
                <a href="{% url 'notes:list' %}" class="tool-card">
                    <span class="icon"><i data-lucide="sticky-note"></i></span>
                    <span>Notes</span>
                </a>
                <a href="{% url 'practice:home' %}" class="tool-card">
                    <span class="icon"><i data-lucide="code-2"></i></span>
                    <span>Practice</span>
                </a>
                <a href="{% url 'assessments:quiz_list' %}" class="tool-card">
                    <span class="icon"><i data-lucide="clipboard-check"></i></span>
                    <span>Tests</span>
                </a>
                <a href="{% url 'ai_tools:home' %}" class="tool-card">
                    <span class="icon"><i data-lucide="bot"></i></span>
                    <span>Study buddy</span>
                </a>
                <a href="{% url 'progress:achievements' %}" class="tool-card">
                    <span class="icon"><i data-lucide="trophy"></i></span>
                    <span>Achievements</span>
                </a>
            </div>
        </div>
    </section>
</div>
{% endblock %}

{% block extra_js %}
<script>
    const heatmapData = {{ heatmap_data|safe }};
    const counterItems = document.querySelectorAll('[data-count]');

    function generateHeatmap() {
        const grid = document.getElementById('heatmapGrid');
        if (!grid) return;
        grid.innerHTML = '';

        heatmapData.forEach(day => {
            const cell = document.createElement('div');
            cell.className = `heatmap-cell level-${day.level}`;
            const date = new Date(day.date);
            const dateStr = date.toLocaleDateString('en-US', {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });
            const activityText = day.level === 0 ? 'No activity' : `Level ${day.level} activity`;
            cell.title = `${dateStr}: ${activityText}`;
            grid.appendChild(cell);
        });
    }

    function animateCounters() {
        counterItems.forEach((item, index) => {
            const target = parseInt(item.dataset.count, 10) || 0;
            const duration = 900 + index * 120;
            const startTime = performance.now();

            function frame(currentTime) {
                const progress = Math.min((currentTime - startTime) / duration, 1);
                const value = Math.floor(progress * target);
                item.textContent = value;
                if (progress < 1) {
                    requestAnimationFrame(frame);
                } else {
                    item.textContent = target;
                }
            }

            requestAnimationFrame(frame);
        });
    }

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                animateCounters();
                observer.disconnect();
            }
        });
    }, { threshold: 0.3 });

    if (counterItems.length) {
        observer.observe(document.querySelector('.stats-row'));
    }

    generateHeatmap();
</script>
{% endblock %}