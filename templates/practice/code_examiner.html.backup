{% extends 'base.html' %}
{% block title %}AI Code Examiner - CodeLabX{% endblock %}
{% block extra_css %}
<style>
body { background: #0A0A0A; color: #e0e0e0; }
.examiner-header { background: var(--accent); border-radius: 8px; padding: 25px; margin-bottom: 25px; color: white; }
.code-card { background: var(--bg-secondary); border: 1px solid rgba(108,99,255,0.2); border-radius: 8px; padding: 25px; margin-bottom: 20px; }
.form-control, .form-select { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 10px; }
.form-control:focus, .form-select:focus { background: rgba(255,255,255,0.08); border-color: #14B8A6; color: white; }
.code-editor { background: #0A0A0A; border: 1px solid rgba(108,99,255,0.3); border-radius: 10px; color: #00D4AA; font-family: monospace; font-size: 14px; min-height: 350px; padding: 20px; width: 100%; resize: vertical; }
.btn-check-code { background: var(--accent); border: none; color: white; padding: 15px 40px; border-radius: 12px; font-weight: 700; font-size: 1.1rem; width: 100%; margin-top: 15px; cursor: pointer; }
.btn-check-code:hover:not(:disabled) { transform: translateY(-2px); color: white; }
.btn-clear-code { background: rgba(255,107,107,0.15); border: 1px solid rgba(255,107,107,0.3); color: #FF6B6B; padding: 10px 20px; border-radius: 10px; cursor: pointer; }
#feedbackContent { color: #e0e0e0; line-height: 1.8; }
#feedbackContent h1, #feedbackContent h2, #feedbackContent h3 { color: white; margin-top: 25px; }
#feedbackContent h2 { border-bottom: 2px solid #14B8A6; padding-bottom: 10px; }
#feedbackContent code { background: rgba(108,99,255,0.15); padding: 2px 8px; border-radius: 4px; color: #FF6B6B; }
#feedbackContent pre { background: #0A0A0A; border: 1px solid rgba(108,99,255,0.3); border-radius: 10px; padding: 20px; overflow-x: auto; }
#feedbackContent pre code { background: none; color: #00D4AA; }
#feedbackContent strong { color: white; }
.spinner-custom { width: 50px; height: 50px; border: 4px solid rgba(108,99,255,0.2); border-top-color: #14B8A6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }
@keyframes spin { to { transform: rotate(360deg); } }
.empty-state { text-align: center; padding: 40px 20px; color: #a0a0a0; }
.empty-state i { font-size: 3.5rem; color: #14B8A6; opacity: 0.5; }
</style>
{% endblock %}
{% block content %}
<div class="examiner-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h2 class="mb-1"><i class="bi bi-robot me-2"></i>AI Code Examiner</h2>
            <p class="mb-0" style="opacity: 0.9;">Get instant AI feedback on your code</p>
        </div>
        <a href="{% url 'practice:task_list' %}" class="btn btn-light btn-sm">Back</a>
    </div>
</div>
<div class="row">
    <div class="col-lg-6">
        <div class="code-card">
            <h5 style="color: white;">Your Code</h5>
            <div class="row mb-3 mt-3">
                <div class="col-md-6 mb-2">
                    <label class="form-label">Language</label>
                    <select id="languageSelect" class="form-select">
                        <option value="python">Python</option>
                        <option value="javascript">JavaScript</option>
                        <option value="java">Java</option>
                        <option value="cpp">C++</option>
                    </select>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label">Load Template</label>
                    <select id="templateSelect" class="form-select" onchange="loadTemplate()">
                        <option value="">Choose...</option>
                        <option value="two_sum">Two Sum</option>
                        <option value="fibonacci">Fibonacci</option>
                        <option value="palindrome">Palindrome</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Problem Statement (Optional)</label>
                <textarea id="problemStatement" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Code</label>
                <textarea id="codeInput" class="code-editor" placeholder="Write code here..."></textarea>
            </div>
            <button type="button" class="btn-check-code" id="checkBtn" onclick="checkCode()">CHECK MY CODE WITH AI</button>
            <div class="text-center mt-3">
                <button type="button" class="btn-clear-code" onclick="clearCode()">Clear All</button>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="code-card">
            <h5 style="color: white;">AI Feedback</h5>
            <div id="feedbackArea" class="mt-3">
                <div class="empty-state" id="emptyState">
                    <i class="bi bi-robot"></i>
                    <h5 style="color: white;">Ready to Review!</h5>
                    <p>Click CHECK MY CODE to get AI feedback.</p>
                </div>
            </div>
            <div id="loadingState" style="display: none;">
                <div class="text-center py-4">
                    <div class="spinner-custom"></div>
                    <h5 style="color: white;">AI is analyzing...</h5>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block extra_js %}
<script>
const templates = {
    two_sum: { problem: "Two Sum: return indices of two numbers that add to target", code: "def two_sum(nums, target):\n    for i in range(len(nums)):\n        for j in range(i+1, len(nums)):\n            if nums[i] + nums[j] == target:\n                return [i, j]\n    return []\n\nprint(two_sum([2,7,11,15], 9))" },
    fibonacci: { problem: "Return nth Fibonacci number", code: "def fib(n):\n    if n <= 1: return n\n    return fib(n-1) + fib(n-2)\n\nprint(fib(10))" },
    palindrome: { problem: "Check if string is palindrome", code: "def is_pal(s):\n    s = s.lower().replace(' ', '')\n    return s == s[::-1]\n\nprint(is_pal('racecar'))" }
};
function loadTemplate() {
    const n = document.getElementById('templateSelect').value;
    if (!n) return;
    document.getElementById('problemStatement').value = templates[n].problem;
    document.getElementById('codeInput').value = templates[n].code;
}
function clearCode() {
    if (confirm('Clear all?')) {
        document.getElementById('codeInput').value = '';
        document.getElementById('problemStatement').value = '';
        document.getElementById('templateSelect').value = '';
    }
}
function getCookie(name) {
    let v = null;
    if (document.cookie) {
        for (let c of document.cookie.split(';')) {
            c = c.trim();
            if (c.startsWith(name + '=')) { v = decodeURIComponent(c.substring(name.length + 1)); break; }
        }
    }
    return v;
}
async function checkCode() {
    const code = document.getElementById('codeInput').value.trim();
    const language = document.getElementById('languageSelect').value;
    const problem = document.getElementById('problemStatement').value.trim();
    if (!code) { alert('Write code first!'); return; }
    const btn = document.getElementById('checkBtn');
    const emptyState = document.getElementById('emptyState');
    const loadingState = document.getElementById('loadingState');
    const feedbackArea = document.getElementById('feedbackArea');
    btn.disabled = true;
    btn.innerHTML = 'ANALYZING...';
    emptyState.style.display = 'none';
    loadingState.style.display = 'block';
    feedbackArea.innerHTML = '';
    try {
        const r = await fetch('/practice/api/check-code/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRFToken': getCookie('csrftoken') },
            body: JSON.stringify({ code, language, problem })
        });
        const d = await r.json();
        loadingState.style.display = 'none';
        if (d.success) {
            feedbackArea.innerHTML = '<div id="feedbackContent">' + d.feedback + '</div>';
        } else {
            feedbackArea.innerHTML = '<div class="alert alert-danger">Error: ' + d.error + '</div>';
        }
    } catch (e) {
        loadingState.style.display = 'none';
        feedbackArea.innerHTML = '<div class="alert alert-danger">Error: ' + e.message + '</div>';
    } finally {
        btn.disabled = false;
        btn.innerHTML = 'CHECK MY CODE WITH AI';
    }
}
</script>
{% endblock %}
