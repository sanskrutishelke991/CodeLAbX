{% extends 'base.html' %}

{% block title %}Analytics - CodeLabX{% endblock %}

{% block extra_css %}
<style>
    body { background: #0A0A0A; color: #e0e0e0; }
    
    .analytics-header {
        background: var(--bg-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 30px;
        margin-bottom: 30px;
        color: white;
    }
    
    .stat-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 25px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        border-color: #14B8A6;
        box-shadow: 0 10px 30px rgba(20, 184, 166, 0.3);
    }
    
    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 10px;
    }
    
    .stat-value {
        font-size: 2.2rem;
        font-weight: 700;
        color: white;
        margin-bottom: 5px;
    }
    
    .stat-label {
        color: #a0a0a0;
        font-size: 0.9rem;
    }
    
    .stat-change {
        font-size: 0.85rem;
        margin-top: 8px;
    }
    
    .stat-change.positive { color: #00D4AA; }
    .stat-change.negative { color: #FF6B6B; }
    
    .chart-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 25px;
    }
    
    .chart-title {
        color: white;
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }
    
    .chart-title i {
        color: #14B8A6;
        margin-right: 10px;
    }
    
    .chart-container {
        position: relative;
        height: 300px;
    }
    
    .insight-card {
        background: linear-gradient(135deg, rgba(20, 184, 166, 0.1) 0%, rgba(0, 212, 170, 0.05) 100%);
        border: 1px solid rgba(20, 184, 166, 0.3);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
    }
    
    .insight-card h6 {
        color: white;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }
    
    .insight-card h6 i {
        margin-right: 8px;
    }
    
    .insight-card p {
        color: #a0a0a0;
        margin: 0;
        font-size: 0.9rem;
    }
    
    .consistency-ring {
        width: 150px;
        height: 150px;
        margin: 0 auto;
        position: relative;
    }
    
    .empty-chart {
        text-align: center;
        padding: 60px 20px;
        color: #a0a0a0;
    }
    
    .empty-chart i {
        font-size: 4rem;
        color: #14B8A6;
        opacity: 0.3;
    }
</style>
{% endblock %}

{% block content %}
<div class="analytics-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h1 class="mb-2"><i class="bi bi-graph-up-arrow me-2"></i>Analytics Dashboard</h1>
            <p class="mb-0" style="opacity: 0.9;">Deep insights into your learning journey</p>
        </div>
        <a href="{% url 'dashboard:home' %}" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Dashboard
        </a>
    </div>
</div>

<!-- Overview Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon">⏱️</div>
            <div class="stat-value">{{ stats.total_hours }}</div>
            <div class="stat-label">Total Hours</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon">📚</div>
            <div class="stat-value">{{ stats.completed_days }}</div>
            <div class="stat-label">Days Completed</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon">🔥</div>
            <div class="stat-value">{{ stats.current_streak }}</div>
            <div class="stat-label">Current Streak</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="stat-icon">🎯</div>
            <div class="stat-value">{{ stats.completion_rate }}%</div>
            <div class="stat-label">Completion Rate</div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column - Charts -->
    <div class="col-lg-8">
        
        <!-- Weekly Activity Chart -->
        <div class="chart-card">
            <h4 class="chart-title">
                <i class="bi bi-calendar-week"></i>Daily Study Time (Last 4 Weeks)
            </h4>
            <div class="chart-container">
                <canvas id="weeklyActivityChart"></canvas>
            </div>
        </div>
        
        <!-- Topic Distribution -->
        <div class="chart-card">
            <h4 class="chart-title">
                <i class="bi bi-pie-chart-fill"></i>Time Distribution by Topic
            </h4>
            {% if topic_labels != '[]' %}
                <div class="chart-container">
                    <canvas id="topicChart"></canvas>
                </div>
            {% else %}
                <div class="empty-chart">
                    <i class="bi bi-pie-chart"></i>
                    <p>Start a learning path to see distribution</p>
                </div>
            {% endif %}
        </div>
        
        <!-- Test Performance -->
        <div class="chart-card">
            <h4 class="chart-title">
                <i class="bi bi-clipboard-check"></i>Test Performance Over Time
            </h4>
            {% if test_labels != '[]' %}
                <div class="chart-container">
                    <canvas id="testChart"></canvas>
                </div>
            {% else %}
                <div class="empty-chart">
                    <i class="bi bi-clipboard-check"></i>
                    <p>Take some tests to see performance trends</p>
                </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Right Column - Insights -->
    <div class="col-lg-4">
        
        <!-- Consistency Score -->
        <div class="chart-card">
            <h4 class="chart-title">
                <i class="bi bi-lightning-charge-fill"></i>Consistency Score
            </h4>
            <div class="consistency-ring">
                <canvas id="consistencyChart"></canvas>
            </div>
            <div class="text-center mt-3">
                <div style="color: white; font-size: 1.5rem; font-weight: 700;">{{ consistency }}%</div>
                <small style="color: #a0a0a0;">Last 30 days</small>
            </div>
        </div>
        
        <!-- Key Insights -->
        <div class="chart-card">
            <h4 class="chart-title">
                <i class="bi bi-lightbulb-fill"></i>Key Insights
            </h4>
            
            <div class="insight-card">
                <h6><i class="bi bi-star-fill text-warning"></i>Total Learning Time</h6>
                <p>You've invested <strong style="color: white;">{{ stats.total_hours }} hours</strong> in learning across {{ stats.total_activity_days }} days.</p>
            </div>
            
            <div class="insight-card">
                <h6><i class="bi bi-fire text-danger"></i>Streak Record</h6>
                <p>Your longest streak: <strong style="color: white;">{{ stats.longest_streak }} days</strong>. Keep it going!</p>
            </div>
            
            {% if stats.estimated_days_to_finish > 0 %}
            <div class="insight-card">
                <h6><i class="bi bi-clock text-info"></i>Estimated Completion</h6>
                <p>At your current pace, you'll finish your active roadmaps in approximately <strong style="color: white;">{{ stats.estimated_days_to_finish }} days</strong>.</p>
            </div>
            {% endif %}
            
            {% if stats.avg_test_score > 0 %}
            <div class="insight-card">
                <h6><i class="bi bi-trophy text-warning"></i>Test Average</h6>
                <p>Your average test score is <strong style="color: white;">{{ stats.avg_test_score }}%</strong> across {{ stats.total_tests }} tests.</p>
            </div>
            {% endif %}
            
            <div class="insight-card">
                <h6><i class="bi bi-graph-up text-success"></i>Daily Average</h6>
                <p>You study approximately <strong style="color: white;">{{ stats.avg_daily_minutes }} minutes</strong> per active day.</p>
            </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="chart-card">
            <h4 class="chart-title">
                <i class="bi bi-lightning"></i>Quick Actions
            </h4>
            <div class="d-grid gap-2">
                <a href="{% url 'learning:roadmap_create' %}" class="btn btn-outline-light">
                    <i class="bi bi-plus-circle me-2"></i>New Roadmap
                </a>
                <a href="{% url 'assessments:quiz_list' %}" class="btn btn-outline-light">
                    <i class="bi bi-clipboard-check me-2"></i>Take Test
                </a>
                <a href="{% url 'progress:achievements' %}" class="btn btn-outline-light">
                    <i class="bi bi-trophy me-2"></i>Achievements
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Chart.js Global Config
    Chart.defaults.color = '#e0e0e0';
    Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.05)';
    
    // Weekly Activity Chart
    const weeklyCtx = document.getElementById('weeklyActivityChart').getContext('2d');
    new Chart(weeklyCtx, {
        type: 'line',
        data: {
            labels: {{ weekly_activity_labels|safe }},
            datasets: [{
                label: 'Minutes Studied',
                data: {{ weekly_activity_data|safe }},
                borderColor: '#14B8A6',
                backgroundColor: 'rgba(20, 184, 166, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#14B8A6',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: { color: '#a0a0a0' }
                },
                x: {
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: { color: '#a0a0a0', maxRotation: 45, minRotation: 45 }
                }
            }
        }
    });
    
    // Topic Distribution Chart
    {% if topic_labels != '[]' %}
    const topicCtx = document.getElementById('topicChart').getContext('2d');
    new Chart(topicCtx, {
        type: 'doughnut',
        data: {
            labels: {{ topic_labels|safe }},
            datasets: [{
                data: {{ topic_data|safe }},
                backgroundColor: [
                    '#14B8A6',
                    '#00D4AA',
                    '#FF6B6B',
                    '#f59e0b',
                    '#14B8A6',
                    '#4a90e2'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#e0e0e0',
                        padding: 15
                    }
                }
            }
        }
    });
    {% endif %}
    
    // Test Performance Chart
    {% if test_labels != '[]' %}
    const testCtx = document.getElementById('testChart').getContext('2d');
    new Chart(testCtx, {
        type: 'bar',
        data: {
            labels: {{ test_labels|safe }},
            datasets: [{
                label: 'Test Score (%)',
                data: {{ test_data|safe }},
                backgroundColor: 'rgba(0, 212, 170, 0.6)',
                borderColor: '#00D4AA',
                borderWidth: 2,
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 100,
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: { color: '#a0a0a0' }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#a0a0a0' }
                }
            }
        }
    });
    {% endif %}
    
    // Consistency Ring
    const consistencyCtx = document.getElementById('consistencyChart').getContext('2d');
    new Chart(consistencyCtx, {
        type: 'doughnut',
        data: {
            datasets: [{
                data: [{{ consistency }}, {{ 100|add:consistency|add:'-100'|add:'-100' }}],
                backgroundColor: [
                    'rgba(0, 212, 170, 0.9)',
                    'rgba(255, 255, 255, 0.05)'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: {
                legend: { display: false },
                tooltip: { enabled: false }
            }
        }
    });
</script>
{% endblock %}