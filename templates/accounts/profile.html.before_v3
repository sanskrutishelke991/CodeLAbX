{% extends 'base.html' %}

{% block title %}{{ profile_user.username }} - Profile - CodeLabX{% endblock %}

{% block extra_css %}
<style>

/* ============================================================
   CODELABX — PROFILE V2
   Premium Developer / Learning Profile
   Backend untouched
   ============================================================ */

.profile-v2 {
    --p-bg: #090a0c;
    --p-card: #181a1f;
    --p-card-2: #1d2026;
    --p-border: rgba(255,255,255,.075);
    --p-border-hover: rgba(80,199,183,.42);

    --p-primary: #50c7b7;
    --p-primary-2: #38b5a5;
    --p-primary-soft: rgba(80,199,183,.10);

    --p-text: #f3f4f6;
    --p-muted: #969aa3;
    --p-muted-2: #6f737c;

    color: var(--p-text);
    position: relative;
    padding-bottom: 50px;
}

/* ------------------------------------------------------------
   Ambient background
   ------------------------------------------------------------ */

.profile-v2::before {
    content: "";
    position: fixed;
    width: 520px;
    height: 520px;
    top: 80px;
    left: 5%;
    background: radial-gradient(
        circle,
        rgba(80,199,183,.075),
        transparent 68%
    );
    pointer-events: none;
    z-index: -1;
}

.profile-v2::after {
    content: "";
    position: fixed;
    width: 500px;
    height: 500px;
    right: 0;
    bottom: 0;
    background: radial-gradient(
        circle,
        rgba(80,199,183,.045),
        transparent 68%
    );
    pointer-events: none;
    z-index: -1;
}

/* ------------------------------------------------------------
   HERO
   ------------------------------------------------------------ */

.profile-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--p-border);
    border-radius: 24px;
    background:
        linear-gradient(
            135deg,
            rgba(29,32,38,.98),
            rgba(20,22,27,.98)
        );
    box-shadow:
        0 25px 70px rgba(0,0,0,.32),
        inset 0 1px 0 rgba(255,255,255,.025);
    margin-bottom: 22px;
}

.profile-hero::before {
    content: "";
    position: absolute;
    width: 500px;
    height: 500px;
    top: -330px;
    right: -100px;
    border-radius: 50%;
    background: rgba(80,199,183,.075);
    filter: blur(10px);
}

.profile-hero::after {
    content: "";
    position: absolute;
    height: 1px;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(80,199,183,.35),
        transparent
    );
}

.profile-hero-inner {
    position: relative;
    z-index: 2;
    padding: 34px;
}

/* ------------------------------------------------------------
   HERO TOP
   ------------------------------------------------------------ */

.profile-identity {
    display: flex;
    align-items: center;
    gap: 26px;
}

.profile-avatar-wrap {
    position: relative;
    flex: 0 0 auto;
}

.profile-avatar-ring {
    width: 138px;
    height: 138px;
    padding: 4px;
    border-radius: 50%;
    background: linear-gradient(
        135deg,
        var(--p-primary),
        rgba(80,199,183,.12),
        var(--p-primary-2)
    );
    box-shadow:
        0 0 0 5px rgba(80,199,183,.055),
        0 0 42px rgba(80,199,183,.20);
}

.profile-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: #252830;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 3rem;
    font-weight: 800;
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-online-dot {
    position: absolute;
    right: 7px;
    bottom: 9px;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--p-primary);
    border: 3px solid #181a1f;
    box-shadow: 0 0 12px rgba(80,199,183,.6);
}

/* ------------------------------------------------------------
   IDENTITY TEXT
   ------------------------------------------------------------ */

.profile-identity-content {
    min-width: 0;
    flex: 1;
}

.profile-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--p-primary);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin-bottom: 8px;
}

.profile-name-v2 {
    margin: 0;
    color: white;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    font-weight: 850;
    letter-spacing: -.045em;
}

.profile-handle {
    margin-top: 9px;
    color: var(--p-muted);
    font-size: .95rem;
}

.profile-location-v2 {
    margin-top: 10px;
    color: #c5c8ce;
    font-size: .9rem;
}

.profile-location-v2 i {
    color: var(--p-primary);
}

.profile-bio-v2 {
    max-width: 650px;
    margin: 15px 0 0;
    color: #c0c3c9;
    line-height: 1.65;
}

/* ------------------------------------------------------------
   HERO ACTIONS
   ------------------------------------------------------------ */

.profile-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
}

.profile-edit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 19px;
    border-radius: 10px;
    background: linear-gradient(
        135deg,
        var(--p-primary),
        var(--p-primary-2)
    );
    color: #07100f !important;
    text-decoration: none;
    font-weight: 800;
    border: none;
    box-shadow: 0 9px 25px rgba(80,199,183,.17);
    transition: .22s ease;
}

.profile-edit-btn:hover {
    transform: translateY(-2px);
    color: #07100f !important;
    box-shadow: 0 14px 32px rgba(80,199,183,.28);
}

.profile-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.09);
    color: #d9dce1 !important;
    cursor: pointer;
    transition: .22s ease;
}

.profile-share-btn:hover {
    border-color: rgba(80,199,183,.38);
    background: var(--p-primary-soft);
    color: var(--p-primary) !important;
}

/* ------------------------------------------------------------
   SOCIALS
   ------------------------------------------------------------ */

.profile-socials {
    display: flex;
    gap: 8px;
    margin-top: 18px;
}

.profile-social {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    color: #aeb2ba !important;
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,255,255,.07);
    text-decoration: none;
    transition: .22s ease;
}

.profile-social:hover {
    color: var(--p-primary) !important;
    border-color: rgba(80,199,183,.4);
    background: var(--p-primary-soft);
    transform: translateY(-2px);
}

/* ------------------------------------------------------------
   LEVEL BADGE
   ------------------------------------------------------------ */

.profile-level-badge {
    position: absolute;
    right: 30px;
    top: 30px;
    min-width: 110px;
    padding: 12px 16px;
    border-radius: 14px;
    background: rgba(80,199,183,.07);
    border: 1px solid rgba(80,199,183,.2);
    text-align: center;
}

.profile-level-badge small {
    display: block;
    color: var(--p-muted);
    font-size: .67rem;
    letter-spacing: .12em;
    font-weight: 700;
}

.profile-level-badge strong {
    display: block;
    margin-top: 2px;
    color: var(--p-primary);
    font-size: 1.55rem;
}

/* ------------------------------------------------------------
   STATS
   ------------------------------------------------------------ */

.profile-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 22px;
}

.profile-stat {
    position: relative;
    overflow: hidden;
    min-height: 118px;
    padding: 19px;
    border-radius: 16px;
    background: linear-gradient(
        145deg,
        rgba(29,32,38,.98),
        rgba(22,24,29,.98)
    );
    border: 1px solid var(--p-border);
    transition: .23s ease;
}

.profile-stat:hover {
    transform: translateY(-3px);
    border-color: var(--p-border-hover);
    box-shadow: 0 14px 35px rgba(0,0,0,.25);
}

.profile-stat-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--p-primary-soft);
    color: var(--p-primary);
    font-size: 1rem;
    margin-bottom: 12px;
}

.profile-stat-value {
    color: white;
    font-size: 1.55rem;
    font-weight: 850;
    line-height: 1;
}

.profile-stat-label {
    margin-top: 6px;
    color: var(--p-muted);
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-weight: 700;
}

/* ------------------------------------------------------------
   MAIN GRID
   ------------------------------------------------------------ */

.profile-main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, .95fr);
    gap: 22px;
}

.profile-column {
    min-width: 0;
}

/* ------------------------------------------------------------
   PANELS
   ------------------------------------------------------------ */

.profile-panel {
    background: linear-gradient(
        145deg,
        rgba(29,32,38,.98),
        rgba(22,24,29,.98)
    );
    border: 1px solid var(--p-border);
    border-radius: 18px;
    padding: 22px;
    margin-bottom: 18px;
    box-shadow:
        0 12px 35px rgba(0,0,0,.17),
        inset 0 1px 0 rgba(255,255,255,.018);
}

.profile-panel:hover {
    border-color: rgba(255,255,255,.11);
}

.profile-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
}

.profile-panel-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: white;
    font-size: 1rem;
    font-weight: 800;
}

.profile-panel-title i {
    color: var(--p-primary);
    font-size: 1.05rem;
}

.profile-panel-subtitle {
    color: var(--p-muted);
    font-size: .75rem;
}

/* ------------------------------------------------------------
   XP PANEL
   ------------------------------------------------------------ */

.xp-panel {
    overflow: hidden;
}

.xp-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 20px;
}

.xp-level {
    color: var(--p-primary);
    font-size: 2.8rem;
    font-weight: 900;
    line-height: .9;
}

.xp-level-label {
    color: var(--p-muted);
    font-size: .68rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 800;
    margin-bottom: 7px;
}

.xp-number {
    color: #fff;
    font-weight: 800;
    font-size: .9rem;
}

.xp-track {
    height: 10px;
    background: rgba(255,255,255,.075);
    border-radius: 99px;
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    width: {{ level.level_progress_percentage|default:0 }}%;
    background: linear-gradient(
        90deg,
        #39b5a5,
        #62d8c8
    );
    border-radius: inherit;
    box-shadow: 0 0 18px rgba(80,199,183,.3);
}

.xp-footer {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 9px;
    color: var(--p-muted);
    font-size: .72rem;
}

/* ------------------------------------------------------------
   SKILLS
   ------------------------------------------------------------ */

.profile-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.profile-skill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-radius: 9px;
    color: #cbd0d5;
    background: rgba(80,199,183,.065);
    border: 1px solid rgba(80,199,183,.2);
    font-size: .78rem;
    font-weight: 700;
    transition: .2s ease;
}

.profile-skill::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--p-primary);
    box-shadow: 0 0 7px rgba(80,199,183,.5);
}

.profile-skill:hover {
    color: var(--p-primary);
    border-color: rgba(80,199,183,.4);
    transform: translateY(-2px);
}

/* ------------------------------------------------------------
   GOALS
   ------------------------------------------------------------ */

.profile-goal {
    color: #c7cbd1;
    line-height: 1.75;
    margin: 0;
}

.profile-goal p:last-child {
    margin-bottom: 0;
}

/* ------------------------------------------------------------
   ROADMAPS
   ------------------------------------------------------------ */

.roadmap-item {
    display: block;
    padding: 16px;
    border-radius: 13px;
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.065);
    color: inherit !important;
    text-decoration: none !important;
    margin-bottom: 10px;
    transition: .22s ease;
}

.roadmap-item:last-child {
    margin-bottom: 0;
}

.roadmap-item:hover {
    background: rgba(80,199,183,.045);
    border-color: rgba(80,199,183,.28);
    transform: translateX(4px);
}

.roadmap-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.roadmap-name {
    color: #f1f2f4;
    font-size: .9rem;
    font-weight: 800;
}

.roadmap-meta {
    margin-top: 5px;
    color: var(--p-muted);
    font-size: .72rem;
}

.roadmap-percent {
    color: var(--p-primary);
    font-size: .78rem;
    font-weight: 850;
    white-space: nowrap;
}

.roadmap-track {
    height: 6px;
    margin-top: 13px;
    border-radius: 99px;
    overflow: hidden;
    background: rgba(255,255,255,.075);
}

.roadmap-fill {
    height: 100%;
    width: {{ roadmap.progress_percentage }}%;
    border-radius: inherit;
    background: linear-gradient(
        90deg,
        #39b5a5,
        #62d8c8
    );
}

/* ------------------------------------------------------------
   ACHIEVEMENTS
   ------------------------------------------------------------ */

.achievement-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}

.achievement {
    min-height: 125px;
    padding: 15px 10px;
    border-radius: 13px;
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.065);
    text-align: center;
    transition: .22s ease;
}

.achievement:hover {
    transform: translateY(-3px);
    border-color: rgba(80,199,183,.3);
    background: rgba(80,199,183,.045);
}

.achievement-icon {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 11px;
}

.achievement-name {
    color: #e5e7eb;
    font-size: .72rem;
    font-weight: 750;
    line-height: 1.3;
}

/* ------------------------------------------------------------
   EMPTY STATE
   ------------------------------------------------------------ */

.profile-empty {
    padding: 30px 15px;
    text-align: center;
    color: var(--p-muted);
}

.profile-empty i {
    display: block;
    margin-bottom: 10px;
    font-size: 2.2rem;
    color: var(--p-primary);
    opacity: .55;
}

.profile-empty p {
    margin-bottom: 12px;
}

/* ------------------------------------------------------------
   SHARE BOX
   ------------------------------------------------------------ */

.profile-share-box {
    margin-top: 15px;
    padding: 12px 14px;
    border-radius: 11px;
    background: rgba(80,199,183,.045);
    border: 1px solid rgba(80,199,183,.15);
}

.profile-share-label {
    display: block;
    color: var(--p-muted);
    font-size: .65rem;
    letter-spacing: .09em;
    text-transform: uppercase;
    font-weight: 800;
    margin-bottom: 5px;
}

.profile-share-code {
    color: var(--p-primary);
    font-family: "JetBrains Mono", monospace;
    font-size: .76rem;
    cursor: pointer;
    word-break: break-all;
}

/* ------------------------------------------------------------
   VIEW ALL BUTTON
   ------------------------------------------------------------ */

.profile-view-all {
    color: var(--p-primary) !important;
    font-size: .72rem;
    font-weight: 750;
    text-decoration: none;
}

.profile-view-all:hover {
    color: #7be0d2 !important;
}

/* ------------------------------------------------------------
   RESPONSIVE
   ------------------------------------------------------------ */

@media (max-width: 991px) {

    .profile-main-grid {
        grid-template-columns: 1fr;
    }

    .profile-hero-inner {
        padding: 28px;
    }

    .profile-level-badge {
        position: static;
        display: inline-block;
        margin-top: 20px;
    }
}

@media (max-width: 700px) {

    .profile-identity {
        align-items: flex-start;
        flex-direction: column;
    }

    .profile-avatar-ring {
        width: 115px;
        height: 115px;
    }

    .profile-name-v2 {
        font-size: 2rem;
    }

    .profile-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .achievement-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .profile-hero-inner {
        padding: 22px;
    }

    .profile-panel {
        padding: 18px;
        border-radius: 15px;
    }
}

@media (max-width: 430px) {

    .profile-stats {
        gap: 8px;
    }

    .profile-stat {
        min-height: 105px;
        padding: 14px;
    }

    .profile-stat-value {
        font-size: 1.3rem;
    }

    .profile-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .profile-edit-btn,
    .profile-share-btn {
        width: 100%;
    }

    .profile-socials {
        flex-wrap: wrap;
    }
}

</style>
{% endblock %}


{% block content %}

<div class="profile-v2">

    <!-- ======================================================
         PROFILE HERO
         ====================================================== -->

    <section class="profile-hero">

        <div class="profile-hero-inner">

            <div class="profile-identity">

                <div class="profile-avatar-wrap">

                    <div class="profile-avatar-ring">

                        <div class="profile-avatar">

                            {% if profile.avatar_url %}
                                <img
                                    src="{{ profile.avatar_url }}"
                                    alt="{{ profile_user.username }}"
                                >
                            {% else %}
                                {{ profile.initials }}
                            {% endif %}

                        </div>

                    </div>

                    <span class="profile-online-dot"></span>

                </div>


                <div class="profile-identity-content">

                    <div class="profile-eyebrow">
                        <i class="bi bi-terminal"></i>
                        CODELABX DEVELOPER
                    </div>

                    <h1 class="profile-name-v2">
                        {{ profile_user.username }}
                    </h1>

                    <div class="profile-handle">
                        @{{ profile_user.username }}
                    </div>

                    {% if profile.location %}
                    <div class="profile-location-v2">
                        <i class="bi bi-geo-alt-fill me-1"></i>
                        {{ profile.location }}
                    </div>
                    {% endif %}

                    {% if profile.bio %}
                    <p class="profile-bio-v2">
                        {{ profile.bio }}
                    </p>
                    {% endif %}


                    <!-- SOCIAL LINKS -->

                    {% if profile.github_url or profile.linkedin_url or profile.twitter_url or profile.website_url %}

                    <div class="profile-socials">

                        {% if profile.github_url %}
                        <a
                            href="{{ profile.github_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="profile-social"
                            title="GitHub"
                        >
                            <i class="bi bi-github"></i>
                        </a>
                        {% endif %}

                        {% if profile.linkedin_url %}
                        <a
                            href="{{ profile.linkedin_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="profile-social"
                            title="LinkedIn"
                        >
                            <i class="bi bi-linkedin"></i>
                        </a>
                        {% endif %}

                        {% if profile.twitter_url %}
                        <a
                            href="{{ profile.twitter_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="profile-social"
                            title="Twitter"
                        >
                            <i class="bi bi-twitter"></i>
                        </a>
                        {% endif %}

                        {% if profile.website_url %}
                        <a
                            href="{{ profile.website_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="profile-social"
                            title="Website"
                        >
                            <i class="bi bi-globe"></i>
                        </a>
                        {% endif %}

                    </div>

                    {% endif %}


                    <!-- ACTIONS -->

                    {% if is_own_profile %}

                    <div class="profile-actions">

                        <a
                            href="{% url 'accounts:profile_edit' %}"
                            class="profile-edit-btn"
                        >
                            <i class="bi bi-pencil-square"></i>
                            Edit Profile
                        </a>

                        <button
                            type="button"
                            class="profile-share-btn"
                            onclick="copyLink()"
                        >
                            <i class="bi bi-share"></i>
                            Share Profile
                        </button>

                    </div>

                    {% endif %}

                </div>


                <!-- LEVEL -->

                <div class="profile-level-badge">

                    <small>CURRENT LEVEL</small>

                    <strong>
                        {{ level.current_level|default:1 }}
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- ======================================================
         STATS
         ====================================================== -->

    <section class="profile-stats">

        <div class="profile-stat">

            <div class="profile-stat-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>

            <div class="profile-stat-value">
                {{ level.current_level|default:1 }}
            </div>

            <div class="profile-stat-label">
                Level
            </div>

        </div>


        <div class="profile-stat">

            <div class="profile-stat-icon">
                <i class="bi bi-stars"></i>
            </div>

            <div class="profile-stat-value">
                {{ level.total_xp_earned|default:0 }}
            </div>

            <div class="profile-stat-label">
                Total XP
            </div>

        </div>


        <div class="profile-stat">

            <div class="profile-stat-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>

            <div class="profile-stat-value">
                {{ total_badges|default:0 }}
            </div>

            <div class="profile-stat-label">
                Badges
            </div>

        </div>


        <div class="profile-stat">

            <div class="profile-stat-icon">
                <i class="bi bi-fire"></i>
            </div>

            <div class="profile-stat-value">
                {{ streak.current_streak|default:0 }}
            </div>

            <div class="profile-stat-label">
                Day Streak
            </div>

        </div>

    </section>


    <!-- ======================================================
         MAIN CONTENT
         ====================================================== -->

    <div class="profile-main-grid">


        <!-- ==================================================
             LEFT / PRIMARY COLUMN
             ================================================== -->

        <div class="profile-column">


            <!-- XP -->

            {% if level %}

            <section class="profile-panel xp-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-graph-up-arrow"></i>
                        Progression
                    </h2>

                    <span class="profile-panel-subtitle">
                        Level {{ level.current_level }}
                    </span>

                </div>


                <div class="xp-header">

                    <div>
                        <div class="xp-level-label">
                            Current Level
                        </div>

                        <div class="xp-level">
                            {{ level.current_level }}
                        </div>
                    </div>

                    <div class="xp-number">
                        {{ level.current_xp }} /
                        {{ level.xp_for_next_level }} XP
                    </div>

                </div>


                <div class="xp-track">

                    <div
                        class="xp-fill"
                        style="width: {{ level.level_progress_percentage }}%;"
                    ></div>

                </div>


                <div class="xp-footer">

                    <span>
                        {{ level.level_progress_percentage }}% complete
                    </span>

                    <span>
                        {{ level.xp_for_next_level|add:"-"|add:level.current_xp }}
                        XP to next level
                    </span>

                </div>

            </section>

            {% endif %}


            <!-- SKILLS -->

            {% if profile.skills %}

            <section class="profile-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-code-slash"></i>
                        Skills & Technologies
                    </h2>

                    <span class="profile-panel-subtitle">
                        TECH STACK
                    </span>

                </div>


                <div class="profile-skills">

                    {% for skill in profile.skills %}

                    <span class="profile-skill">
                        {{ skill }}
                    </span>

                    {% endfor %}

                </div>

            </section>

            {% endif %}


            <!-- LEARNING GOALS -->

            {% if profile.learning_goals %}

            <section class="profile-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-bullseye"></i>
                        Learning Goals
                    </h2>

                    <span class="profile-panel-subtitle">
                        CURRENT FOCUS
                    </span>

                </div>

                <div class="profile-goal">
                    {{ profile.learning_goals|linebreaks }}
                </div>

            </section>

            {% endif %}


            <!-- ROADMAPS -->

            <section class="profile-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-map"></i>
                        Current Learning Paths
                    </h2>

                    {% if active_roadmaps %}
                    <span class="profile-panel-subtitle">
                        {{ active_roadmaps|length }} ACTIVE
                    </span>
                    {% endif %}

                </div>


                {% if active_roadmaps %}

                    {% for roadmap in active_roadmaps %}

                    <a
                        href="{% url 'learning:roadmap_detail' roadmap.id %}"
                        class="roadmap-item"
                    >

                        <div class="roadmap-top">

                            <div>

                                <div class="roadmap-name">

                                    {% if roadmap.topic == 'ML' %}
                                        🤖
                                    {% else %}
                                        💻
                                    {% endif %}

                                    {{ roadmap.title }}

                                </div>

                                <div class="roadmap-meta">

                                    Day {{ roadmap.completed_days }}/{{ roadmap.total_days }}

                                    • {{ roadmap.get_level_display }}

                                </div>

                            </div>


                            <div class="roadmap-percent">
                                {{ roadmap.progress_percentage }}%
                            </div>

                        </div>


                        <div class="roadmap-track">

                            <div
                                class="roadmap-fill"
                                style="width: {{ roadmap.progress_percentage }}%;"
                            ></div>

                        </div>

                    </a>

                    {% endfor %}

                {% else %}

                    <div class="profile-empty">

                        <i class="bi bi-map"></i>

                        <p>
                            No active learning paths yet.
                        </p>

                        {% if is_own_profile %}

                        <a
                            href="{% url 'learning:roadmap_create' %}"
                            class="profile-edit-btn"
                        >
                            <i class="bi bi-plus-lg"></i>
                            Create Learning Path
                        </a>

                        {% endif %}

                    </div>

                {% endif %}

            </section>


        </div>


        <!-- ==================================================
             RIGHT / ACHIEVEMENTS COLUMN
             ================================================== -->

        <div class="profile-column">


            <!-- ACHIEVEMENTS -->

            <section class="profile-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-trophy-fill"></i>
                        Achievements
                    </h2>

                    {% if is_own_profile %}

                    <a
                        href="{% url 'progress:achievements' %}"
                        class="profile-view-all"
                    >
                        VIEW ALL
                    </a>

                    {% endif %}

                </div>


                {% if recent_badges %}

                <div class="achievement-grid">

                    {% for user_badge in recent_badges %}

                    <div class="achievement">

                        <div class="achievement-icon">
                            {{ user_badge.badge.icon }}
                        </div>

                        <div class="achievement-name">
                            {{ user_badge.badge.name }}
                        </div>

                    </div>

                    {% endfor %}

                </div>

                {% else %}

                <div class="profile-empty">

                    <i class="bi bi-award"></i>

                    <p>
                        No badges earned yet.
                    </p>

                </div>

                {% endif %}

            </section>


            <!-- PROFILE SNAPSHOT -->

            <section class="profile-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-person-badge"></i>
                        Profile Snapshot
                    </h2>

                </div>


                <div style="
                    display:grid;
                    gap:12px;
                ">

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        gap:15px;
                        color:#969aa3;
                        font-size:.78rem;
                    ">
                        <span>Username</span>
                        <strong style="color:#e8eaed;">
                            @{{ profile_user.username }}
                        </strong>
                    </div>


                    {% if profile.location %}

                    <div style="
                        display:flex;
                        justify-content:space-between;
                        gap:15px;
                        color:#969aa3;
                        font-size:.78rem;
                    ">
                        <span>Location</span>
                        <strong style="color:#e8eaed;">
                            {{ profile.location }}
                        </strong>
                    </div>

                    {% endif %}


                    <div style="
                        display:flex;
                        justify-content:space-between;
                        gap:15px;
                        color:#969aa3;
                        font-size:.78rem;
                    ">
                        <span>Badges</span>
                        <strong style="color:#50c7b7;">
                            {{ total_badges|default:0 }}
                        </strong>
                    </div>


                    <div style="
                        display:flex;
                        justify-content:space-between;
                        gap:15px;
                        color:#969aa3;
                        font-size:.78rem;
                    ">
                        <span>Current Streak</span>
                        <strong style="color:#50c7b7;">
                            {{ streak.current_streak|default:0 }} days
                        </strong>
                    </div>

                </div>

            </section>


            <!-- SHARE -->

            {% if is_own_profile %}

            <section class="profile-panel">

                <div class="profile-panel-heading">

                    <h2 class="profile-panel-title">
                        <i class="bi bi-share"></i>
                        Share Profile
                    </h2>

                </div>


                <div class="profile-share-box">

                    <span class="profile-share-label">
                        Public Profile
                    </span>

                    <code
                        class="profile-share-code"
                        id="shareLink"
                        onclick="copyLink()"
                    >
                        /user/{{ profile_user.username }}/
                    </code>

                </div>

            </section>

            {% endif %}


        </div>

    </div>

</div>

{% endblock %}


{% block extra_js %}

<script>

function copyLink() {

    const link =
        window.location.origin +
        '/accounts/user/{{ profile_user.username }}/';

    navigator.clipboard.writeText(link).then(() => {

        const codeEl =
            document.getElementById('shareLink');

        if (!codeEl) return;

        const original =
            codeEl.textContent;

        codeEl.textContent =
            '✓ Copied to clipboard';

        setTimeout(() => {
            codeEl.textContent = original;
        }, 2000);

    }).catch(() => {

        const codeEl =
            document.getElementById('shareLink');

        if (!codeEl) return;

        const original =
            codeEl.textContent;

        codeEl.textContent =
            'Copy failed';

        setTimeout(() => {
            codeEl.textContent = original;
        }, 2000);

    });

}

</script>

{% endblock %}
