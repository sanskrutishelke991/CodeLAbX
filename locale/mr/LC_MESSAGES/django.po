msgid ""
msgstr ""
"Project-Id-Version: CodeLabX\n"
"Language: mr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Apply language"
msgstr "भाषा लागू करा"

msgid "Browser default"
msgstr "ब्राउझर डीफॉल्ट"

msgid "Browser speech recognition · explicit permission"
msgstr "ब्राउझर स्पीच ओळख · स्पष्ट परवानगी"

msgid "Browser voice · no audio upload"
msgstr "ब्राउझर आवाज · ऑडिओ अपलोड नाही"

msgid "Close text-to-speech controls"
msgstr "टेक्स्ट-टू-स्पीच नियंत्रणे बंद करा"

msgid "Close voice coding input controls"
msgstr "व्हॉइस कोडिंग इनपुट नियंत्रणे बंद करा"

msgid "CodeLabX cannot reach the server"
msgstr "CodeLabX सर्व्हरशी संपर्क करू शकत नाही"

msgid "CodeLabX does not record or store microphone audio. Your browser or operating-system speech provider may process it under its own policy."
msgstr "CodeLabX मायक्रोफोन ऑडिओ रेकॉर्ड किंवा साठवत नाही. तुमचा ब्राउझर किंवा ऑपरेटिंग-सिस्टम स्पीच प्रदाता त्यांच्या धोरणानुसार त्यावर प्रक्रिया करू शकतो."

msgid "Coding voice commands"
msgstr "कोडिंग व्हॉइस कमांड"

msgid "Focus a text or code field before starting."
msgstr "सुरू करण्यापूर्वी मजकूर किंवा कोड फील्डवर लक्ष केंद्रित करा."

msgid "Get Started"
msgstr "सुरू करा"

msgid "Install CodeLabX"
msgstr "CodeLabX इन्स्टॉल करा"

msgid "Install CodeLabX on this device"
msgstr "या डिव्हाइसवर CodeLabX इन्स्टॉल करा"

msgid "Interface language"
msgstr "इंटरफेस भाषा"

msgid "Microphone access starts only after you press Start listening."
msgstr "“ऐकणे सुरू करा” दाबल्यानंतरच मायक्रोफोन प्रवेश सुरू होतो."

msgid "Offline"
msgstr "ऑफलाइन"

msgid "Open text-to-speech controls"
msgstr "टेक्स्ट-टू-स्पीच नियंत्रणे उघडा"

msgid "Open voice coding input controls"
msgstr "व्हॉइस कोडिंग इनपुट नियंत्रणे उघडा"

msgid "Pause"
msgstr "थांबवा"

msgid "Read"
msgstr "वाचा"

msgid "Read aloud"
msgstr "मोठ्याने वाचा"

msgid "Read page aloud"
msgstr "पान मोठ्याने वाचा"

msgid "Recognition language"
msgstr "ओळख भाषा"

msgid "Reconnect to continue. Private dashboards, chats, assessments, and learning records are intentionally not cached for offline access."
msgstr "पुढे जाण्यासाठी पुन्हा कनेक्ट करा. खासगी डॅशबोर्ड, चॅट, मूल्यमापन आणि शिकण्याच्या नोंदी ऑफलाइन वापरासाठी जाणीवपूर्वक कॅश केल्या जात नाहीत."

msgid "Say commands such as new line, indent, colon, comma, open parenthesis, close parenthesis, equals, or stop listening. Commands also support selected Hindi and Marathi equivalents."
msgstr "न्यू लाइन, इंडेंट, कोलन, कॉमा, ओपन पॅरेन्थेसिस, क्लोज पॅरेन्थेसिस, इक्वल्स किंवा स्टॉप लिसनिंग असे कमांड बोला. निवडक हिंदी आणि मराठी पर्यायही समर्थित आहेत."

msgid "Select text to read only that selection, or read the main page content."
msgstr "फक्त निवडलेला मजकूर वाचण्यासाठी तो निवडा, किंवा मुख्य पानाचा मजकूर वाचा."

msgid "Sign in"
msgstr "साइन इन"

msgid "Skip to main content"
msgstr "मुख्य मजकुराकडे जा"

msgid "Speed"
msgstr "वेग"

msgid "Start listening"
msgstr "ऐकणे सुरू करा"

msgid "Stop"
msgstr "बंद करा"

msgid "Text-to-speech controls"
msgstr "टेक्स्ट-टू-स्पीच नियंत्रणे"

msgid "Toggle color theme"
msgstr "रंग थीम बदला"

msgid "Toggle theme"
msgstr "थीम बदला"

msgid "Try again"
msgstr "पुन्हा प्रयत्न करा"

msgid "Voice"
msgstr "आवाज"

msgid "Voice coding input"
msgstr "व्हॉइस कोडिंग इनपुट"

msgid "Voice coding input controls"
msgstr "व्हॉइस कोडिंग इनपुट नियंत्रणे"
