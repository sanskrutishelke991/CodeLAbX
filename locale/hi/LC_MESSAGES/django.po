msgid ""
msgstr ""
"Project-Id-Version: CodeLabX\n"
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Apply language"
msgstr "भाषा लागू करें"

msgid "Browser default"
msgstr "ब्राउज़र डिफ़ॉल्ट"

msgid "Browser speech recognition · explicit permission"
msgstr "ब्राउज़र स्पीच पहचान · स्पष्ट अनुमति"

msgid "Browser voice · no audio upload"
msgstr "ब्राउज़र वॉइस · कोई ऑडियो अपलोड नहीं"

msgid "Close text-to-speech controls"
msgstr "टेक्स्ट-टू-स्पीच नियंत्रण बंद करें"

msgid "Close voice coding input controls"
msgstr "वॉइस कोडिंग इनपुट नियंत्रण बंद करें"

msgid "CodeLabX cannot reach the server"
msgstr "CodeLabX सर्वर तक नहीं पहुँच पा रहा है"

msgid "CodeLabX does not record or store microphone audio. Your browser or operating-system speech provider may process it under its own policy."
msgstr "CodeLabX माइक्रोफ़ोन ऑडियो रिकॉर्ड या संग्रहीत नहीं करता। आपका ब्राउज़र या ऑपरेटिंग सिस्टम स्पीच प्रदाता इसे अपनी नीति के अनुसार संसाधित कर सकता है।"

msgid "Coding voice commands"
msgstr "कोडिंग वॉइस कमांड"

msgid "Focus a text or code field before starting."
msgstr "शुरू करने से पहले टेक्स्ट या कोड फ़ील्ड पर फ़ोकस करें।"

msgid "Get Started"
msgstr "शुरू करें"

msgid "Install CodeLabX"
msgstr "CodeLabX इंस्टॉल करें"

msgid "Install CodeLabX on this device"
msgstr "इस डिवाइस पर CodeLabX इंस्टॉल करें"

msgid "Interface language"
msgstr "इंटरफ़ेस भाषा"

msgid "Microphone access starts only after you press Start listening."
msgstr "माइक्रोफ़ोन एक्सेस केवल “सुनना शुरू करें” दबाने के बाद शुरू होता है।"

msgid "Offline"
msgstr "ऑफ़लाइन"

msgid "Open text-to-speech controls"
msgstr "टेक्स्ट-टू-स्पीच नियंत्रण खोलें"

msgid "Open voice coding input controls"
msgstr "वॉइस कोडिंग इनपुट नियंत्रण खोलें"

msgid "Pause"
msgstr "रोकें"

msgid "Read"
msgstr "पढ़ें"

msgid "Read aloud"
msgstr "ज़ोर से पढ़ें"

msgid "Read page aloud"
msgstr "पृष्ठ को ज़ोर से पढ़ें"

msgid "Recognition language"
msgstr "पहचान भाषा"

msgid "Reconnect to continue. Private dashboards, chats, assessments, and learning records are intentionally not cached for offline access."
msgstr "जारी रखने के लिए दोबारा कनेक्ट करें। निजी डैशबोर्ड, चैट, आकलन और सीखने के रिकॉर्ड ऑफ़लाइन उपयोग के लिए जानबूझकर कैश नहीं किए जाते।"

msgid "Say commands such as new line, indent, colon, comma, open parenthesis, close parenthesis, equals, or stop listening. Commands also support selected Hindi and Marathi equivalents."
msgstr "न्यू लाइन, इंडेंट, कोलन, कॉमा, ओपन पैरेंथेसिस, क्लोज़ पैरेंथेसिस, इक्वल्स या स्टॉप लिसनिंग जैसे कमांड बोलें। चुने हुए हिंदी और मराठी कमांड भी समर्थित हैं।"

msgid "Select text to read only that selection, or read the main page content."
msgstr "केवल चयन पढ़ने के लिए टेक्स्ट चुनें, या मुख्य पृष्ठ सामग्री पढ़ें।"

msgid "Sign in"
msgstr "साइन इन"

msgid "Skip to main content"
msgstr "मुख्य सामग्री पर जाएँ"

msgid "Speed"
msgstr "गति"

msgid "Start listening"
msgstr "सुनना शुरू करें"

msgid "Stop"
msgstr "बंद करें"

msgid "Text-to-speech controls"
msgstr "टेक्स्ट-टू-स्पीच नियंत्रण"

msgid "Toggle color theme"
msgstr "रंग थीम बदलें"

msgid "Toggle theme"
msgstr "थीम बदलें"

msgid "Try again"
msgstr "फिर प्रयास करें"

msgid "Voice"
msgstr "आवाज़"

msgid "Voice coding input"
msgstr "वॉइस कोडिंग इनपुट"

msgid "Voice coding input controls"
msgstr "वॉइस कोडिंग इनपुट नियंत्रण"
